public class Exercicio04 {

   
    public static void main(String[] args) {


        // Criando um objeto Livro
        Livro livro1 = new Livro("O Senhor dos Anéis", "J.R.R. Tolkien", 1200, 3);

        // Exibindo informações do livro
        livro1.exibirInfo();

        // Testando empréstimos
        livro1.emprestar();
